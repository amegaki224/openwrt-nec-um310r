#!/bin/sh

BOARD="$(cat /tmp/sysinfo/board_name 2>/dev/null)"
[ "$BOARD" = "nec,um310r" ] || exit 0

# 95-um310r-amm570 creates this section on a clean installation.
[ "$(uci -q get network.wan.proto)" = "amm570" ] || exit 0

# PPP creates the dynamic wan_6 DHCPv6 interface. EXTENDPREFIX enables
# the RFC 7278 fallback when the mobile carrier supplies a routed /64
# address but no DHCPv6-PD prefix.
uci set network.wan.ipv6='auto'
uci set network.wan.extendprefix='1'

# Remove the temporary troubleshooting form if that exact value exists;
# amm570.sh now supplies EXTENDPREFIX directly and safely.
if [ "$(uci -q get network.wan.pppd_options)" = "set EXTENDPREFIX=1" ]; then
	uci -q delete network.wan.pppd_options
fi

# Release 4 selects the delayed hook directly in amm570.sh.  Remove the
# exact temporary setting used while validating the netifd race workaround.
if [ "$(uci -q get network.wan.pppd_options)" = "ip-up-script /usr/sbin/um310r-ppp-up" ]; then
	uci -q delete network.wan.pppd_options
fi

uci set network.lan.ip6assign='64'

uci -q get dhcp.lan >/dev/null ||
	uci set dhcp.lan='dhcp'

uci set dhcp.lan.interface='lan'
uci set dhcp.lan.ra='server'
uci set dhcp.lan.dhcpv6='server'
uci set dhcp.lan.ndp='disabled'

# Keep odhcpd's automatic default-route safety check. Do not advertise
# an unusable IPv6 default route when a replacement SIM has no IPv6.
uci -q delete dhcp.lan.ra_default

# NDP relay cannot operate correctly on the PPP/NOARP AMM570 device.
uci -q set dhcp.wan.ignore='1'
uci -q delete dhcp.wan.master
uci -q delete dhcp.wan.ra
uci -q delete dhcp.wan.dhcpv6
uci -q delete dhcp.wan.ndp

uci commit network
uci commit dhcp
